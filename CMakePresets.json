{
  "version": 6,
  "configurePresets": [
    {
      "name": "f407-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "f407-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": false
      }
    },
    {
      "name": "f407-release",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_ENABLE_USB_CDC": false
      }
    },
    {
      "name": "f407-usb-cdc-debug",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PNX_ENABLE_USB_CDC": true
      }
    },
    {
      "name": "f407-usb-cdc-release",
      "inherits": "f407-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PNX_ENABLE_USB_CDC": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "f407-debug",
      "configurePreset": "f407-debug"
    },
    {
      "name": "f407-release",
      "configurePreset": "f407-release"
    },
    {
      "name": "f407-usb-cdc-debug",
      "configurePreset": "f407-usb-cdc-debug"
    },
    {
      "name": "f407-usb-cdc-release",
      "configurePreset": "f407-usb-cdc-release"
    }
  ]
}
